SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=xxxxx
SHOPIFY_CLIENT_SECRET=xxxxx
META_ACCESS_TOKEN=xxxxx
META_PHONE_NUMBER_ID=xxxxx
META_VERIFY_TOKEN=your-own-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional
SHOPIFY_API_VERSION=2025-10
GRAPH_API_VERSION=v21.0
WEBHOOK_REGISTER_KEY=some-random-string   # protects GET /register-webhooks
BASE_ADDRESS=https://your-app.up.railway.app  # used by register-webhooks.js
